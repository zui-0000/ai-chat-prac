{
  // .void/tsconfig.json は void prepare が生成する（routes.d.ts などの型を読み込む）。
  // paths は書かない。書くと extends 先の Void の paths（void/db・@schema など）が丸ごと上書きされて消える。src のエイリアスは package.json の imports（#/）
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["void/env", "vite/client", "msw/vite/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    // #/ の import は拡張子まで書く。imports の置き換え先に、TypeScript は .ts を補わない
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts", "void.config.ts"],
  // テストとその準備は tsconfig.test.json で見る。ここで外すと、__tests__ の外に置いたテストは test・expect の型がなく型エラーになる
  "exclude": ["src/**/__tests__", "src/client/__setup__"]
}
