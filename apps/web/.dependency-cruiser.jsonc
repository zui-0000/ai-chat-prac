// apps/web の中の import の向き。パッケージをまたぐ向きは package.json の依存で守る。
// .jsonc は既定の設定ファイル名に無いので --config で渡す。渡さないと、決まりを読まずに「違反なし」で通る
{
  "forbidden": [
    {
      "name": "client-not-to-server",
      "comment": "src/client から src/server を読んでいます（import type も止めます）。FE は @ai-chat/contract の契約だけを使ってください",
      "severity": "error",
      "from": { "path": "^src/client/" },
      "to": { "path": "^src/server/" }
    },
    {
      // @schema・void/db は Void の paths で当てた名前で、ファイルまでたどれないので名前で止める。
      // モックは契約を実装するので @orpc/server を許す
      "name": "client-not-to-server-modules",
      "comment": "src/client から BE 専用のモジュール（@schema・void/db・@orpc/server など）を読んでいます。FE は @ai-chat/contract と @orpc/client だけを使ってください",
      "severity": "error",
      "from": { "path": "^src/client/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-|@orpc/server)" }
    },
    {
      // 本物の DB に寄りかかると、契約とのずれに気づけない
      "name": "mocks-not-to-db",
      "comment": "モックの BE から本物の DB を読んでいます。モックは @ai-chat/contract の契約だけを見て作ってください",
      "severity": "error",
      "from": { "path": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-)" }
    },
    {
      // モックを本番のバンドルに入れない。main.tsx は開発のときだけ動的 import で読む
      "name": "client-not-to-mocks",
      "comment": "モックの BE を読んでいます。読んでよいのは main.tsx とテストだけです",
      "severity": "error",
      "from": {
        "path": "^src/client/",
        "pathNot": "(^src/client/main\\.tsx$|^src/client/mocks/|^src/client/__setup__/|/__tests__/)"
      },
      "to": { "path": "^src/client/mocks/" }
    },
    {
      // 中の並べ方を変えても、外を直さずに済むように
      "name": "mocks-entry-only",
      "comment": "モックの BE の中を直接読んでいます。外からは入口（browser.ts・node.ts）だけを読んでください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^src/client/mocks/", "pathNot": "^src/client/mocks/(browser|node)\\.ts$" }
    },

    // src/client の向き: main.tsx → App.tsx → routes → components → hooks → stores・api → utils → constants。
    // 下から上は読まない。テストは外す
    {
      "name": "client-entry-not-imported",
      "comment": "main.tsx・App.tsx を読んでいます。入口はほかから読まないでください",
      "severity": "error",
      "from": { "path": "^src/client/", "pathNot": "(^src/client/main\\.tsx$|/__tests__/)" },
      "to": { "path": "^src/client/(main|App)\\.tsx$" }
    },
    {
      "name": "components-not-to-routes",
      "comment": "components から routes を読んでいます。ルートの情報が要るときは getRouteApi を使ってください",
      "severity": "error",
      "from": { "path": "^src/client/components/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      "name": "hooks-not-to-upper",
      "comment": "hooks から components・routes を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/hooks/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(components/|routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      // サーバーのデータは TanStack Query だけが持ち、ストアにコピーしない
      "name": "stores-not-to-upper",
      "comment": "stores から api・hooks・components・routes を読んでいます。ストアには UI の状態だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/stores/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(api/|hooks/|components/|routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      "name": "api-not-to-upper",
      "comment": "api から stores・hooks・components・routes を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/api/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(stores/|hooks/|components/|routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      "name": "utils-pure",
      "comment": "utils から constants のほかのフォルダか、React とその仲間のライブラリを読んでいます。utils には純粋な関数だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/utils/", "pathNot": "/__tests__/" },
      "to": {
        "path": "(^src/client/(?!utils/|constants/)|node_modules/(react|react-dom|@tanstack/react-[^/]+|zustand|lucide-react)/)"
      }
    },
    {
      "name": "constants-pure",
      "comment": "constants からほかのフォルダか、React とその仲間のライブラリを読んでいます。constants には値だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/constants/", "pathNot": "/__tests__/" },
      "to": {
        "path": "(^src/client/(?!constants/)|node_modules/(react|react-dom|@tanstack/react-[^/]+|zustand|lucide-react)/)"
      }
    },
    {
      // モックは契約だけを見て作る。FE のコードに寄りかかると、契約とのずれに気づけない
      "name": "mocks-not-to-client",
      "comment": "モックの BE から src/client のほかのフォルダを読んでいます。モックは @ai-chat/contract の契約だけを見て作ってください",
      "severity": "error",
      "from": { "path": "^src/client/mocks/" },
      "to": { "path": "^src/client/(?!mocks/)" }
    },

    // 部品の向き: routes → pages・layouts → features → ui。下から上は読まない
    {
      "name": "ui-not-to-upper",
      "comment": "components/ui から features・layouts・pages を読んでいます。ui には、特定の機能や契約を知らない見た目の部品だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/components/ui/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/components/(features|layouts|pages)/" }
    },
    {
      // API の形が変わっても、見た目の部品を直さずに済むように
      "name": "ui-not-to-contract",
      "comment": "components/ui から契約（@ai-chat/contract）を読んでいます。ui の部品は props の型を自分で持ち、契約の形への詰め替えは features でしてください",
      "severity": "error",
      "from": { "path": "^src/client/components/ui/", "pathNot": "/__tests__/" },
      "to": { "path": "^@ai-chat/contract" }
    },
    {
      "name": "features-not-to-upper",
      "comment": "components/features から layouts・pages を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/components/features/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/components/(layouts|pages)/" }
    },
    {
      // 別の機能でも要る見た目の部品は ui に下ろす。特定の機能や契約を知る部品は ui に下ろさない
      "name": "features-not-to-other-features",
      "comment": "components/features の機能から、ほかの機能を読んでいます。両方で要るもののうち、特定の機能も契約も知らない見た目の部品は components/ui に下ろしてください",
      "severity": "error",
      "from": { "path": "^src/client/components/features/([^/]+)/", "pathNot": "/__tests__/" },
      "to": {
        "path": "^src/client/components/features/",
        "pathNot": "^src/client/components/features/$1/"
      }
    },
    {
      "name": "pages-and-layouts-apart",
      "comment": "components/pages と components/layouts が、お互いを読んでいます。共通のものは features か ui に置いてください",
      "severity": "error",
      "from": { "path": "^src/client/components/(pages|layouts)/", "pathNot": "/__tests__/" },
      "to": {
        "path": "^src/client/components/(pages|layouts)/",
        "pathNot": "^src/client/components/$1/"
      }
    },

    {
      "name": "server-not-to-client",
      "comment": "src/server から src/client を読んでいます",
      "severity": "error",
      "from": { "path": "^src/server/" },
      "to": { "path": "^src/client/" }
    },
    {
      "name": "no-test-runner-in-app",
      "comment": "アプリのコードから vite-plus/test を読んでいます。テストの道具は __tests__ と __setup__ の中だけで使ってください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^vite-plus/test" }
    },
    {
      "name": "no-test-support-in-app",
      "comment": "アプリのコードから __setup__ を読んでいます",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^src/client/__setup__/" }
    },
    {
      "name": "no-circular",
      "comment": "循環参照になっています",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true,
        // 型だけの循環は実行時に消える
        "viaOnly": { "dependencyTypesNot": ["type-only"] }
      }
    }
  ],
  "options": {
    // TypeScript 7 では、既定の parser が 1 ファイルも読めず「違反なし」で通ってしまう
    "parser": "swc",
    "doNotFollow": { "path": "node_modules" },
    "tsConfig": { "fileName": "tsconfig.app.json" }
  }
}
