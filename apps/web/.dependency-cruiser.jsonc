// apps/web の中の import の向き。パッケージをまたぐ向きは package.json の依存で守る
{
  "forbidden": [
    {
      "name": "client-not-to-server",
      "comment": "src/client から src/server を読んでいます。FE は @ai-chat/contract の約束だけを使ってください",
      "severity": "error",
      "from": { "path": "^src/client/" },
      "to": { "path": "^src/server/" }
    },
    {
      // @schema・void/db は Void の paths で当てた名前で、ファイルまでたどれないので名前で止める。
      // 偽物は約束を実装するので @orpc/server を許す
      "name": "client-not-to-server-modules",
      "comment": "src/client から BE 専用のモジュール（@schema・void/db・@orpc/server など）を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-|@orpc/server)" }
    },
    {
      // 本物の DB に寄りかかると、約束とのずれに気づけない
      "name": "mocks-not-to-db",
      "comment": "偽物の BE から本物の DB を読んでいます。偽物は @ai-chat/contract の約束だけを見て作ってください",
      "severity": "error",
      "from": { "path": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-)" }
    },
    {
      // 偽物を本番のバンドルに入れない。main.tsx は開発のときだけ動的 import で読む
      "name": "client-not-to-mocks",
      "comment": "偽物の BE を読んでいます。読んでよいのは main.tsx とテストだけです",
      "severity": "error",
      "from": {
        "path": "^src/client/",
        "pathNot": "(^src/client/main\\.tsx$|^src/client/mocks/|^src/client/__setup__/|/__tests__/)"
      },
      "to": { "path": "^src/client/mocks/" }
    },
    {
      // 中の並べ方を変えても、外を直さずに済むように
      "name": "mocks-entry-only",
      "comment": "偽物の BE の中を直接読んでいます。外からは入口（browser.ts・node.ts）だけを読んでください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^src/client/mocks/", "pathNot": "^src/client/mocks/(browser|node)\\.ts$" }
    },

    // src/client の向き: main.tsx → App.tsx → routes → components → hooks → stores・api → utils。
    // 下から上は読まない。テストは外す
    {
      "name": "client-entry-not-imported",
      "comment": "main.tsx・App.tsx を読んでいます。入口はほかから読まないでください",
      "severity": "error",
      "from": { "path": "^src/client/", "pathNot": "(^src/client/main\\.tsx$|/__tests__/)" },
      "to": { "path": "^src/client/(main|App)\\.tsx$" }
    },
    {
      "name": "components-not-to-routes",
      "comment": "components から routes を読んでいます。ルートの情報が要るときは getRouteApi を使ってください",
      "severity": "error",
      "from": { "path": "^src/client/components/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      "name": "hooks-not-to-upper",
      "comment": "hooks から components・routes を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/hooks/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(components/|routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      "name": "stores-api-not-to-upper",
      "comment": "stores・api から hooks・components・routes を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/(stores|api)/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/(hooks/|components/|routes/|routeTree\\.gen\\.ts$)" }
    },
    {
      // サーバーのデータは TanStack Query だけが持ち、ストアにコピーしない
      "name": "stores-not-to-api",
      "comment": "stores から api を読んでいます。ストアには UI の状態だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/stores/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/api/" }
    },
    {
      "name": "api-not-to-stores",
      "comment": "api から stores を読んでいます",
      "severity": "error",
      "from": { "path": "^src/client/api/", "pathNot": "/__tests__/" },
      "to": { "path": "^src/client/stores/" }
    },
    {
      "name": "utils-pure",
      "comment": "utils からほかのフォルダか React を読んでいます。utils には純粋な関数だけを置いてください",
      "severity": "error",
      "from": { "path": "^src/client/utils/", "pathNot": "/__tests__/" },
      "to": { "path": "(^src/client/(?!utils/)|node_modules/(react|react-dom)/)" }
    },

    {
      "name": "server-not-to-client",
      "comment": "src/server から src/client を読んでいます",
      "severity": "error",
      "from": { "path": "^src/server/" },
      "to": { "path": "^src/client/" }
    },
    {
      "name": "no-test-runner-in-app",
      "comment": "アプリのコードから vite-plus/test を読んでいます。テストの道具は __tests__ と __setup__ の中だけで使ってください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^vite-plus/test" }
    },
    {
      "name": "no-test-support-in-app",
      "comment": "アプリのコードから __setup__ を読んでいます",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^src/client/__setup__/" }
    },
    {
      "name": "no-circular",
      "comment": "循環参照になっています",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true,
        // 型だけの循環は実行時に消える
        "viaOnly": { "dependencyTypesNot": ["type-only"] }
      }
    }
  ],
  "options": {
    // TypeScript 7 では、既定の parser が 1 ファイルも読めず「違反なし」で通ってしまう
    "parser": "swc",
    "doNotFollow": { "path": "node_modules" },
    "tsConfig": { "fileName": "tsconfig.app.json" }
  }
}
