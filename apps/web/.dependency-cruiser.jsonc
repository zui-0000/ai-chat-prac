// apps/web の中の import の向きを検査する。パッケージをまたぐ向きは package.json の依存で守る。
// 標準の設定ファイル名に .jsonc は含まれないので、--config で指定して実行する（lint:deps）
{
  "forbidden": [
    {
      // import type も止める。FE が BE について知ってよいのは @ai-chat/contract だけ
      "name": "client-not-to-server",
      "comment": "src/client から src/server を import しています。FE からは @ai-chat/contract の約束だけを使ってください",
      "severity": "error",
      "from": { "path": "^src/client/" },
      "to": { "path": "^src/server/" }
    },
    {
      // BE 専用のモジュールを名前で止める。@schema・void/db は Void が .void/tsconfig.json の paths で当てた名前で、
      // dependency-cruiser は extends 先の paths をたどれず、名前のまま残る。
      // 偽物の BE（src/client/mocks）は、oRPC の約束を実装するために @orpc/server を使うので外す。@schema・void/db は下のルールで止める
      "name": "client-not-to-server-modules",
      "comment": "src/client から BE 専用のモジュール（@schema・void/db・@orpc/server など）を import しています。FE からは @ai-chat/contract と @orpc/client だけを使ってください",
      "severity": "error",
      "from": { "path": "^src/client/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-|@orpc/server)" }
    },
    {
      // 偽物は約束（@ai-chat/contract）だけを見て実装する。本物の DB に寄りかかると、約束とのずれに気づけない
      "name": "mocks-not-to-db",
      "comment": "src/client/mocks から本物の DB（@schema・void/db など）を import しています。偽物は @ai-chat/contract の約束だけを見て実装してください",
      "severity": "error",
      "from": { "path": "^src/client/mocks/" },
      "to": { "path": "^(@schema|void/db|void/schema-)" }
    },
    {
      // 偽物の BE（MSW）が本番のバンドルに入らないようにする。main.tsx は開発のときだけ動的 import で読む
      "name": "client-not-to-mocks",
      "comment": "src/client/mocks を import しています。偽物の BE を読んでよいのは main.tsx とテストだけです",
      "severity": "error",
      "from": {
        "path": "^src/client/",
        "pathNot": "(^src/client/main\\.tsx$|^src/client/mocks/|^src/client/__setup__/|/__tests__/)"
      },
      "to": { "path": "^src/client/mocks/" }
    },
    {
      // 外から読むのを入口だけにして、mocks の中の並べ方を変えても外を直さずに済むようにする
      "name": "mocks-entry-only",
      "comment": "src/client/mocks の中のファイルを直接 import しています。外からは入口（browser.ts・node.ts）だけを読んでください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "^src/client/mocks/" },
      "to": { "path": "^src/client/mocks/", "pathNot": "^src/client/mocks/(browser|node)\\.ts$" }
    },
    {
      "name": "server-not-to-client",
      "comment": "src/server から src/client を import しています。BE から FE のコードは使わないでください",
      "severity": "error",
      "from": { "path": "^src/server/" },
      "to": { "path": "^src/client/" }
    },
    {
      // テストの道具がアプリのコードとバンドルに入らないようにする
      "name": "no-test-runner-in-app",
      "comment": "アプリのコードから vite-plus/test を import しています。テストの道具は __tests__ と src/client/__setup__ の中だけで使ってください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^vite-plus/test" }
    },
    {
      "name": "no-test-support-in-app",
      "comment": "アプリのコードから src/client/__setup__ を import しています。テストの準備はテストからだけ使ってください",
      "severity": "error",
      "from": { "path": "^src/", "pathNot": "(/__tests__/|^src/client/__setup__/)" },
      "to": { "path": "^src/client/__setup__/" }
    },
    {
      "name": "no-circular",
      "comment": "循環参照になっています。依存の輪を切ってください",
      "severity": "error",
      "from": {},
      "to": {
        "circular": true,
        // 型だけの循環は実行時に消えるので許す
        "viaOnly": { "dependencyTypesNot": ["type-only"] }
      }
    }
  ],
  "options": {
    // TypeScript 7 には dependency-cruiser が使う JS の API がなく、既定の parser では 1 ファイルも読めずに「違反なし」で通ってしまう
    "parser": "swc",
    "doNotFollow": { "path": "node_modules" },
    "tsConfig": { "fileName": "tsconfig.app.json" }
  }
}
